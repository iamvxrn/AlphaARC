# Copy this file to .env and fill in your real key. .env is gitignored --
# never commit it, never paste its contents into chat.
#
# Get a key by registering at https://three.arcprize.org
ARC_API_KEY=

# Optional -- pkg/environment/remote defaults to https://three.arcprize.org
# already (the real game-session host, confirmed 2026-08-13; arcprize.org
# itself only serves games listing/scorecards, not RESET/actions). Only set
# this to point at a local dev server instead.
# ARC_BASE_URL=
